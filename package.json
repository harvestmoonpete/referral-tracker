{
  "name": "referral-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:integration": "node scripts/integration.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  },
  "engines": {
    "node": ">=24"
  }
}
